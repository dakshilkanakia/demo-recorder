{
  "name": "demo-recorder",
  "version": "0.1.0",
  "description": "Local Playwright demo video recorder for the MERN ecommerce site.",
  "private": true,
  "type": "module",
  "scripts": {
    "record": "tsx src/cli.ts",
    "record:add-to-cart": "tsx src/cli.ts --steps steps/add-to-cart.md",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "recording",
    "ecommerce"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@playwright/test": "^1.56.1",
    "dotenv": "^17.2.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3"
  }
}
